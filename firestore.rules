// HELIOS - FIRESTORE SECURITY RULES
//
// HOW TO APPLY:
// 1. Go to Firebase Console -> Firestore Database -> Rules tab
// 2. Delete everything in the editor
// 3. Copy everything below the dashed line and paste it
// 4. Click Publish
//
// -----------------------------------------------------------------------
// PASTE BELOW THIS LINE INTO FIRESTORE RULES EDITOR:
// -----------------------------------------------------------------------

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -- Helper functions --
    function isAuthed() {
      return request.auth != null;
    }

    function userId() {
      return request.auth.uid;
    }

    function isCardMember(cardId) {
      return isAuthed() &&
        exists(/databases/$(database)/documents/cards/$(cardId)/members/$(userId()));
    }

    function getMember(cardId) {
      return get(/databases/$(database)/documents/cards/$(cardId)/members/$(userId())).data;
    }

    function isCardAdmin(cardId) {
      return isCardMember(cardId) &&
        (getMember(cardId).role == 'OWNER' || getMember(cardId).isAdmin == true);
    }

    function isMedic(cardId) {
      return isCardMember(cardId) &&
        (getMember(cardId).canTreatOthers == true || isCardAdmin(cardId));
    }

    // The single privileged owner/operator identity — same account used to
    // log into the main app and the separate admin key-generator app.
    // Pinned to the actual account UID, NOT a username field. users/{uid} is
    // self-writable (see below), so checking a username value would let any
    // authenticated user grant themselves owner-admin just by renaming
    // themselves to "Sidious" from devtools.
    function isOwnerAdmin() {
      return isAuthed() && userId() == 'J4lApBTvLba6hU5ZXqb0PqIyWqp1';
    }

    // -- Users --
    // Each user can read/write their own profile. Sidious can also write any
    // user's profile - needed to set/clear the banned flag from the admin
    // panel (account suspension has no other enforcement point, since this
    // app has no backend of its own to gate sign-in server-side).
    match /users/{userId} {
      allow read:  if isAuthed();
      allow write: if isAuthed() && (request.auth.uid == userId || isOwnerAdmin());
    }

    // -- Invite codes (cards) --
    // A separate top-level collection, keyed by the code itself, so joining
    // a card is an exact-ID get (never a list/query across cards).
    // list: false means no one can enumerate other factions' codes - only
    // someone who already has the exact 6-character code can resolve it.
    match /inviteCodes/{code} {
      allow get:  if isAuthed();
      allow list: if false;
      allow create: if isAuthed() &&
        exists(/databases/$(database)/documents/cards/$(request.resource.data.cardId)/members/$(userId()));
      allow delete: if isAuthed() &&
        exists(/databases/$(database)/documents/cards/$(resource.data.cardId)/members/$(userId()));
      allow update: if false; // regenerating a code deletes the old doc and creates a new one
    }

    // -- License keys --
    // Doc ID is the key code itself. Only Sidious (via the admin app) can
    // generate/list/delete keys — regular users can only look up ONE exact
    // code (needed to check/activate it), never browse all of them.
    match /licenseKeys/{code} {
      allow get:  if isAuthed();
      allow list: if isOwnerAdmin();
      allow create: if isOwnerAdmin();
      allow delete: if isOwnerAdmin();
      // Activation (flipping activated false -> true) happens ONLY through
      // the createCardWithKey / renewCardLicense Cloud Functions now (Admin
      // SDK, bypasses these rules entirely) - never via a direct client
      // write. Rules can only check a key's CURRENT state as a precondition
      // on some other document's write, they can't require that activating
      // the key and creating/renewing the card happen in the same commit -
      // a client could previously write a card directly while skipping the
      // licenseKeys write, leaving the key looking untouched and reusable.
      // Closing client write access here is what actually closes that hole.
      allow update: if isOwnerAdmin();
    }

    // -- Cards (faction workspaces) --
    match /cards/{cardId} {
      // isOwnerAdmin() (Sidious) can read/list every card - powers the "all
      // cards" table in the separate admin key-generator app, and lets that
      // same account read every subcollection below when deleting a card.
      allow read:  if isCardMember(cardId) || isOwnerAdmin();
      // Sidious can create a card directly (no key needed). Everyone else
      // creates a licensed card through the createCardWithKey Cloud
      // Function (Admin SDK) instead of a direct client write - see the
      // licenseKeys update rule above for why. A licensed card can never be
      // created by a direct client write now, full stop.
      allow create: if isOwnerAdmin();
      // Any card admin can update non-license fields freely (rename, invite
      // code, rules text, etc). licenseKeyCode/licenseExpiresAt can only
      // change through the renewCardLicense Cloud Function (Admin SDK) -
      // a direct client write can never touch either field, so this branch
      // only ever passes when they're left exactly as they already were.
      allow update: if isCardAdmin(cardId) &&
        request.resource.data.licenseExpiresAt == resource.data.licenseExpiresAt &&
        request.resource.data.licenseKeyCode == resource.data.licenseKeyCode;
      // Sidious can delete any card - used by the admin panel's "delete
      // card" control. The card doc itself is only half the data though;
      // the admin app also walks and deletes every subcollection below
      // (members/roles/channels/operations/brevity/units/events) plus the
      // matching medical/{cardId}/patients docs, since Firestore never
      // cascade-deletes subcollections on its own.
      allow delete: if isOwnerAdmin() ||
        ( isAuthed() &&
          get(/databases/$(database)/documents/cards/$(cardId)).data.ownerId == userId()
        );

      // -- Members --
      match /members/{memberId} {
        // Members can read the whole roster; anyone can read their OWN
        // prospective member doc (needed for the "am I already a member?"
        // check that runs before joinCard creates that doc).
        allow read:   if isCardMember(cardId) || memberId == userId() || isOwnerAdmin();

        // Self-join. Only the very first member of a not-yet-existing card
        // (the card-creation transaction in doCreateCard) may create
        // themselves with owner/admin privileges. Every join to an ALREADY
        // existing card must come in with none — the app already sends
        // role:'OPERATOR'/isAdmin:false for that path, but the rule enforces
        // it too, so a devtools-crafted join can't just hand itself admin.
        allow create: if isAuthed() && memberId == userId() &&
          ( !exists(/databases/$(database)/documents/cards/$(cardId)) ||
            ( request.resource.data.isAdmin == false &&
              request.resource.data.role != 'OWNER' &&
              request.resource.data.canTreatOthers == false &&
              request.resource.data.canCreateOps == false &&
              request.resource.data.canEditBrevity == false &&
              request.resource.data.canMultiChan == false
            )
          );

        // Admins can change anything about any member (promote, demote,
        // edit loadout, kick). A member editing their OWN doc (presence,
        // inventory, profile fields) may never change their own privilege
        // fields — otherwise any joined member could self-promote to admin
        // with a direct updateDoc from devtools.
        allow update: if isCardAdmin(cardId) ||
          ( memberId == userId() &&
            request.resource.data.isAdmin == resource.data.isAdmin &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.canTreatOthers == resource.data.canTreatOthers &&
            request.resource.data.canCreateOps == resource.data.canCreateOps &&
            request.resource.data.canEditBrevity == resource.data.canEditBrevity &&
            request.resource.data.canMultiChan == resource.data.canMultiChan
          );
        allow delete: if isCardAdmin(cardId) || memberId == userId() || isOwnerAdmin(); // admin, self-leave, or Sidious (card deletion)
      }

      // -- Roles --
      match /roles/{roleId} {
        allow read:   if isCardMember(cardId) || isOwnerAdmin();
        allow write:  if isCardAdmin(cardId) || isOwnerAdmin();
      }

      // -- Channels --
      match /channels/{chanId} {
        allow read:   if isCardMember(cardId) || isOwnerAdmin();
        allow write:  if isCardAdmin(cardId) || isOwnerAdmin();
      }

      // -- Operations --
      match /operations/{opId} {
        allow read:   if isCardMember(cardId) || isOwnerAdmin();
        // Only members with canCreateOps permission (or admin) can write
        allow write:  if isCardAdmin(cardId) || isOwnerAdmin() ||
          (isCardMember(cardId) && getMember(cardId).canCreateOps == true);
      }

      // -- Brevity codes --
      match /brevity/{codeId} {
        allow read:   if isCardMember(cardId) || isOwnerAdmin();
        allow write:  if isCardAdmin(cardId) || isOwnerAdmin() ||
          (isCardMember(cardId) && getMember(cardId).canEditBrevity == true);
      }

      // -- Units (ORBAT) --
      // NOTE: this collection had no rules at all before - under Firestore's
      // default-deny behavior that meant unit creation was silently rejected
      // for every user, regardless of role.
      match /units/{unitId} {
        allow read:   if isCardMember(cardId) || isOwnerAdmin();
        allow write:  if isCardAdmin(cardId) || isOwnerAdmin();
      }

      // -- Events (activity/audit log) --
      // Append-only: any member can log an event about their OWN action
      // (going down, being revived, treating someone, starting/archiving an
      // op) but can never attribute an event to someone else, and nothing
      // is ever editable once written — it's a log, not state. Sidious can
      // delete (only as part of a full card deletion), but never update.
      match /events/{eventId} {
        allow read:   if isCardMember(cardId) || isOwnerAdmin();
        allow create: if isCardMember(cardId) && request.resource.data.actorUid == userId();
        allow update: if false;
        allow delete: if isOwnerAdmin();
      }
    }

    // -- Medical records --
    // cardId scoped - each card has its own medical board
    match /medical/{cardId}/patients/{patientId} {
      // Any card member (or Sidious) can read medical data
      allow read: if isCardMember(cardId) || isOwnerAdmin();

      // Players can update their OWN medical record
      allow write: if isCardMember(cardId) && patientId == userId();

      // Medics can update ANY patient's record in their card
      allow write: if isMedic(cardId);

      // Sidious - only ever exercised as part of a full card deletion
      allow write: if isOwnerAdmin();
    }

    // -- Joint Ops (cross-faction coordination) --
    // Joint ops are inherently a shared surface between multiple, otherwise
    // unrelated factions - there's no single "card" whose membership rules
    // can gate access the way the per-card collections above do. Any
    // authenticated user can read/write here; the sensitive per-faction data
    // (roster, roles, medical, brevity) stays fully gated above regardless.
    match /jointOpCodes/{code} {
      allow get:  if isAuthed();
      allow list: if false;
      allow create: if isAuthed();
      allow delete: if isAuthed();
      allow update: if false;
    }

    match /jointOps/{joId} {
      allow read:   if isAuthed();
      allow create: if isAuthed();
      allow update: if isAuthed();
      allow delete: if false;

      match /participants/{cardId} {
        allow read:  if isAuthed();
        allow write: if isAuthed();
      }
      match /casualties/{uid} {
        allow read:  if isAuthed();
        allow write: if isAuthed() && uid == userId();
      }
    }

    // -- WebRTC Signaling (voice) --
    // NOTE: voice.js actually signals over the Realtime Database, not
    // Firestore - these Firestore rules for /rtc are never consulted. The
    // rules that really govern voice are the Realtime Database rules from
    // README.md Step 1E (rtc/$cardId -> auth != null). Left here in case a
    // future version moves signaling into Firestore.
    match /rtc/{cardId}/channels/{chanId}/peers/{peerId} {
      allow read:  if isCardMember(cardId);
      allow write: if isCardMember(cardId);
    }

    match /rtc/{cardId}/channels/{chanId}/signals/{signalId} {
      allow read:  if isCardMember(cardId);
      allow write: if isCardMember(cardId);
      allow delete: if isCardMember(cardId);
    }
  }
}
